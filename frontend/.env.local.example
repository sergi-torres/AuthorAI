# ─── Frontend env template ───────────────────────────────────────────────────
# Copy to `frontend/.env.local` (git-ignored) before running `npm run dev`.
#
#   cp frontend/.env.local.example frontend/.env.local
#
# Why this file exists, and not just the repo-root `.env.example`:
# Next.js loads env files from the Next project root — this `frontend/` folder —
# not from the repository root. So `cp .env.example .env` at the root (README
# step 2) sets NEXT_PUBLIC_API_BASE_URL for the backend and the scripts, but the
# browser bundle never sees it.
#
# The mistake is invisible in local dev, because the fallback in
# `src/lib/api.ts` is the same `http://localhost:8000` you would have set. It
# only bites when you point the frontend at a non-local backend.
#
# Only NEXT_PUBLIC_-prefixed variables are exposed to the browser. Never put a
# secret in this file: everything here ships inside the client bundle.

# Base URL of the AutorIA backend. In production this is the Railway URL,
# e.g. "https://autoria-api.up.railway.app" (see docs/DEPLOYMENT.md § Vercel).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
